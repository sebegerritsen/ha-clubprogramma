  "services": {
    "set_presence": {
      "name": "Set attendance",
      "description": "Says in LISA whether a family member comes to a training, match or team event. The team sees it.",
      "fields": {
        "device_id": {
          "name": "Family member",
          "description": "The family member's device."
        },
        "activity_id": {
          "name": "Activity",
          "description": "The activity_id from one of the member's sensors."
        },
        "status": {
          "name": "Attendance",
          "description": "Present, absent, or not given."
        }
      }
    }
  },
