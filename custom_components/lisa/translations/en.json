{
  "config": {
    "step": {
      "user": {
        "title": "Your club in LISA",
        "description": "Log in the same way as in your club's LISA app. Parents see their children's activities too.",
        "data": {
          "sport": "Sport",
          "query": "Club name or town"
        },
        "data_description": {
          "query": "For example a part of the club's name, or its town."
        }
      },
      "club": {
        "title": "Pick the club",
        "data": {
          "club_id": "Club"
        }
      },
      "login": {
        "title": "Log in to LISA",
        "description": "The member number and password you use in the LISA app of {club}.",
        "data": {
          "login_type": "Log in with",
          "number": "Member number",
          "password": "Password"
        },
        "data_description": {
          "number": "Your club membership number, or your federation (KNHB/KNLTB) number.",
          "password": "The password of the LISA club app."
        }
      },
      "reauth_confirm": {
        "title": "Log in to LISA again",
        "description": "LISA no longer accepts the password for member {number}.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach LISA. Try again later.",
      "invalid_auth": "LISA did not accept this member number and password.",
      "no_clubs_found": "No club found. Try a shorter part of the name, or the town."
    },
    "abort": {
      "already_configured": "This LISA login is already set up.",
      "reauth_successful": "Logged in again.",
      "wrong_account": "That is a different member than before."
    }
  },
